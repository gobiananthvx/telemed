# Telemed Environment Configuration

# Database
POSTGRES_USER=telemed_user
POSTGRES_PASSWORD=telemed_password
POSTGRES_DB=telemed_db
POSTGRES_PORT=5434
POSTGRES_HOST=localhost

# Backend Database URL
DATABASE_URL=postgresql+asyncpg://telemed_user:telemed_password@localhost:5434/telemed_db
SYNC_DATABASE_URL=postgresql://telemed_user:telemed_password@localhost:5434/telemed_db

# Security
SECRET_KEY=telemed_jwt_secret_key_super_secure_9847293847293847
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Administrator Credentials (Auto-created on backend startup if not in DB)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@telemed.com
ADMIN_PASSWORD=admin

# Native Python SMTP Email Service
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=true
SMTP_SSL=false
EMAIL_FROM=no-reply@telemed.com

# Backend Service
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Vite Frontend Environment
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000/ws

# Telemed AI Assistant LLM Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini/gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=groq/llama-3.3-70b-versatile
CHATBOT_TIMEZONE=Asia/Kolkata
